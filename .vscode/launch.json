{
  "configurations": [
    {
      "args": ["main:app", "--host", "0.0.0.0", "--port", "8001", "--reload"],
      "cwd": "${workspaceFolder}/Reviewer",
      "justMyCode": true,
      "module": "uvicorn",
      "name": "Debug Agent",
      //"preLaunchTask": "wait-for-readiness",
      "request": "launch",
      "type": "debugpy"
    },
    {
      "name": "Python: Flask UI",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "ui.py",
        "FLASK_DEBUG": "1"
      },
      "args": ["run", "--no-debugger", "--no-reload", "--port", "5001"],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}/Reviewer"
    }
  ],
  "version": "0.2.0"
}
